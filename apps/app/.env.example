NEXT_PUBLIC_PROJECTIONS_BASE_URL="https://epanet-js.github.io/epanet-js-projections"

NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

CLERK_SECRET_KEY=
CLERK_WEBHOOK_TOKEN=
SIGN_IN_URL=
NEXT_PUBLIC_SIGN_UP_URL=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# PostHog Proxy Configuration
# Set to 'true' to route PostHog requests through Vercel proxy (/ingest)
# This helps bypass ad blockers and provides first-party data collection
NEXT_PUBLIC_POSTHOG_PROXY=true
NEXT_PUBLIC_SKIP_USER_TRACKING=true

GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_PROJECT_ID=

SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_PROXY=true

FLAG_SWOT=true
STUDENT_TEST_EMAIL=
SWOT_CHECKER_URL=

NEXT_PUBLIC_PING_URL="https://www.cloudflare.com/cdn-cgi/trace"

# When set, the model-builder iframe loads this URL.
# Unset => falls back to the legacy (v1) model-builder URL.
NEXT_PUBLIC_MODEL_BUILDER_V2_URL=

# The billing app, which owns Stripe checkout.
# Unset => https://billing.epanetjs.com
NEXT_PUBLIC_BILLING_URL=

# Slack Webhooks
SLACK_USERS_WEBHOOK=

# Canny (feedback board). Same secret is used both as the REST API key and to
# sign SSO tokens; found in Canny settings.
CANNY_PRIVATE_KEY=

# Bearer secret for the uptime-monitor health endpoints. Unset => the check is skipped.
HEALTH_SECRET=
